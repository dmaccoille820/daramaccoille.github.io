# Jeopardy AI - Environment Configuration

# 1. Google Gemini API Key (required for AI question generation from uploaded PDFs)
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Neon PostgreSQL Database Connection String
# Get this from https://console.neon.tech/
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
